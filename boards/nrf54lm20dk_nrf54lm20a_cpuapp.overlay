/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
		zephyr,bt-mon-uart = &cdc_acm_uart0;
		zephyr,bt-c2h-uart = &cdc_acm_uart0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
		};

		led1: led_1 {
			gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
		};
	};

	gpios {
		compatible = "gpio-leds";

		dc0: dc_0 {
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		};

		rst0: rst_0 {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		};

		cs0: cs_0 {
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
		};

		te0: te_0 {
			gpios = <&gpio1 7 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		};

		hc165shld: hc165shld {
			gpios = <&gpio1 31 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio1 26 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Any button pressed";
		};
	};

	battery-divider {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc 3>;
		output-ohms = <1>;
		full-ohms = <5>;
	};

	aliases {
		sw0 = &button0;
		adcctrl = &adc;
		led0 = &led0;  // is this necessary?
		led1 = &led1;  // is this necessary?
		dc0 = &dc0;
		rst0 = &rst0;
		cs0 = &cs0;
		te0 = &te0;
		zephyr-udc0 = &usbhs;
		hc165shld = &hc165shld;
	};
};

&pinctrl {
	// Display
	// these are on gpio bank 2 because spi00 is a part of gpio bank 2
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_SCK, 2, 1)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_SCK, 2, 1)>;
			low-power-enable;
		};
	};

	// Shift register for button inputs
	spi_sr: spi_sr {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, // CLK
				<NRF_PSEL(SPIM_MISO, 1, 15)>; // QH (pin 9)
		};
	};

	// SD card
	custom_spi: custom_spi {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,
				<NRF_PSEL(SPIM_MISO, 1, 0)>;
		};
	};
};

// Display
&spi00 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	max-frequency = <DT_FREQ_M(32)>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
};

// SD card
&spi23 {
	status = "okay";
	pinctrl-0 = <&custom_spi>;
	pinctrl-1 = <&custom_spi>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		label = "SDHC_0";

		mmc {
			disk-name = "SD";
			compatible = "zephyr,sdmmc-disk";
			status = "okay";
		};

		spi-max-frequency = <24000000>;
	};
};

// Shift register for button inputs
&spi21 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	max-frequency = <DT_FREQ_M(1)>;
	pinctrl-0 = <&spi_sr>;
	pinctrl-names = "default";

	sr165: sr165@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>; // 1Mhz, should probably be 4MHz
	};
};

&usbhs {
	status = "okay";

	usb_device_0: usb_device_0 {
		compatible = "zephyr,usbd";
		status = "okay";

		usb_config_0: usb_config_0 {
			compatible = "zephyr,usbd-config";

			cdc_acm_uart0: cdc_acm_uart0 {
				compatible = "zephyr,cdc-acm-uart";
			};

			msc_0: msc_0 {
				compatible = "zephyr,usbd-msc";
			};
		};
	};
};
